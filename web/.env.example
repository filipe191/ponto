# Credenciais do Postgres existente (container postgres_db, usuário dedicado "ponto")
PGUSER=ponto
PGPASSWORD=troque-aqui

# Superadministrador, criado na primeira subida (cadastra as empresas em /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=ponto123

# Chave que assina o cookie de sessão (gere com: openssl rand -hex 32)
SECRET_KEY=troque-aqui
# Chave do hash dos PINs (gere com: openssl rand -hex 32).
# NUNCA troque depois de definida: todos os PINs param de funcionar.
PIN_KEY=troque-aqui
# O site só funciona por HTTPS (certificado próprio, ver README)
COOKIE_SECURE=true
# true liga a documentação da API em /api/docs
API_DOCS=false
# Porta do HTTPS no servidor
HTTPS_PORT=9443
# Destino rsync da cópia dos backups (já cifrados) fora do servidor, ex.: usuario@maquina:/backups/ponto/
BACKUP_REMOTO=
# Verificação em duas etapas obrigatória para os administradores
ADMIN_2FA_REQUIRED=true
# Só para instalações anteriores às várias empresas: nome e contato de privacidade da empresa nº 1,
# usados uma vez na migração. Depois disso cada empresa tem os seus no cadastro (Administração → Empresas).
EMPRESA_NOME=
PRIVACIDADE_CONTATO=
