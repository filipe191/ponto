# Copie para .env e preencha. O .env nao vai para o git.
#   cp .env.example .env
#
# Gere os valores secretos com:
#   openssl rand -hex 32    # PONTO_API_KEY
#   openssl rand -hex 16    # POSTGRES_PASSWORD

POSTGRES_DB=ponto
POSTGRES_USER=ponto
POSTGRES_PASSWORD=

# O host "db" e o nome do servico no docker-compose.
# Rodando fora do Docker, troque por localhost:5433
DB_URL=jdbc:postgresql://db:5432/ponto
DB_USER=ponto
DB_PASSWORD=

# Mesma chave que voce informa em Ajustes no app
PONTO_API_KEY=

TZ=America/Sao_Paulo
